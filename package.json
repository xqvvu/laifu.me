{
  "name": "laifu.me",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "check": "pnpm lint && pnpm build",
    "typecheck": "nuxt typecheck",
    "dev": "nuxt dev -p 5173 --host",
    "format": "oxfmt . '!**/*.md'",
    "format:check": "oxfmt --check . '!**/*.md'",
    "generate": "nuxt generate",
    "lint": "pnpm lint:oxlint && pnpm lint:md",
    "lint:oxlint": "oxlint .",
    "lint:md": "mdclint README.md content/**/*.md",
    "prepare": "lefthook install",
    "preview": "nuxt preview",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report",
    "test:e2e:trace": "playwright show-trace",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:codegen": "playwright codegen http://localhost:5173",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/content": "^3.16.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/seo": "^5.3.16",
    "nuxt": "^4.6.1",
    "reading-time": "^1.5.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "lefthook": "^2.2.1",
    "mdclint": "^0.1.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.12"
  },
  "packageManager": "pnpm@12.11.2"
}
