{
  "name": "laifu.me",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "check": "pnpm lint && pnpm build",
    "typecheck": "nuxt typecheck",
    "dev": "nuxt dev -p 5173 --host",
    "format": "oxfmt . '!**/*.md'",
    "format:check": "oxfmt --check . '!**/*.md'",
    "generate": "nuxt generate",
    "lint": "pnpm lint:eslint && pnpm lint:md",
    "lint:eslint": "eslint .",
    "lint:md": "mdclint README.md content/**/*.md",
    "lint:inspector": "pnpx @eslint/config-inspector",
    "prepare": "lefthook install",
    "preview": "nuxt preview",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "playwright show-report",
    "test:e2e:trace": "playwright show-trace",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:codegen": "playwright codegen http://localhost:5173",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/content": "^3.15.1",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/seo": "^5.3.6",
    "gsap": "^3.15.0",
    "nuxt": "^4.5.0",
    "reading-time": "^1.5.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@iconify-json/catppuccin": "^1.2.17",
    "@iconify-json/lucide": "^1.2.118",
    "@iconify/tailwind4": "^1.2.3",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.61.1",
    "eslint": "^10.7.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "lefthook": "^2.1.10",
    "mdclint": "^0.1.2",
    "oxfmt": "^0.60.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.16.0"
}
