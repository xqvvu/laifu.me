{
  "Blog post frontmatter": {
    "scope": "markdown,mdx",
    "prefix": ["blog", "blogpost", "blog-fm"],
    "description": "New blog post frontmatter (content/blog/YYYY/slug.md)",
    "body": [
      "---",
      "title: \"${1:Post title}\"",
      "description: \"${2:Post summary}\"",
      "date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "tags: [\"${3:Tag}\"]",
      "draft: ${4|false,true|}",
      "featured: ${5|false,true|}",
      "---",
      "",
      "## ${6:Opening}",
      "",
      "$0",
    ],
  },
  "Blog post draft frontmatter": {
    "scope": "markdown,mdx",
    "prefix": ["blogdraft", "blog-draft"],
    "description": "Draft blog post frontmatter with updated field",
    "body": [
      "---",
      "title: \"${1:Post title}\"",
      "description: \"${2:Post summary}\"",
      "date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "updated: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
      "tags: [\"${3:Tag}\"]",
      "cover: \"${4:}\"",
      "draft: true",
      "featured: false",
      "---",
      "",
      "## ${5:Opening}",
      "",
      "$0",
    ],
  },
  "MDC note callout": {
    "scope": "markdown,mdx",
    "prefix": ["mdcnote", "note"],
    "description": "MDC note callout",
    "body": ["::note", "${1:Supplementary note.}", "::", "$0"],
  },
  "MDC tip callout": {
    "scope": "markdown,mdx",
    "prefix": ["mdctip", "tip"],
    "description": "MDC tip callout",
    "body": ["::tip", "${1:Best practice or suggestion.}", "::", "$0"],
  },
  "MDC warning callout": {
    "scope": "markdown,mdx",
    "prefix": ["mdcwarn", "warning"],
    "description": "MDC warning callout",
    "body": ["::warning", "${1:Risk, limitation, or caveat.}", "::", "$0"],
  },
  "MDC card": {
    "scope": "markdown,mdx",
    "prefix": ["mdccard", "card"],
    "description": "MDC card with title and icon",
    "body": [
      "::card",
      "---",
      "title: ${1:Card title}",
      "icon: ${2:i-lucide-book-open}",
      "---",
      "${3:Card body.}",
      "::",
      "$0",
    ],
  },
  "MDC tabs": {
    "scope": "markdown,mdx",
    "prefix": ["mdctabs", "tabs"],
    "description": "MDC tabs with two items",
    "body": [
      "::tabs",
      "  ::tabs-item{label=\"${1:pnpm}\" icon=\"i-lucide-terminal\"}",
      "  ```${2:bash}",
      "  ${3:pnpm dev}",
      "  ```",
      "  ::",
      "",
      "  ::tabs-item{label=\"${4:npm}\" icon=\"i-lucide-terminal\"}",
      "  ```${2:bash}",
      "  ${5:npm run dev}",
      "  ```",
      "  ::",
      "::",
      "$0",
    ],
  },
  "MDC code group": {
    "scope": "markdown,mdx",
    "prefix": ["mdccodegroup", "codegroup", "code-group"],
    "description": "MDC code-group for package managers",
    "body": [
      "::code-group{sync=\"${1:package-manager}\"}",
      "```bash [pnpm]",
      "${2:pnpm dev}",
      "```",
      "",
      "```bash [npm]",
      "${3:npm run dev}",
      "```",
      "",
      "```bash [bun]",
      "${4:bun run dev}",
      "```",
      "::",
      "$0",
    ],
  },
  "MDC code collapse": {
    "scope": "markdown,mdx",
    "prefix": ["mdccodecollapse", "codecollapse", "code-collapse"],
    "description": "MDC collapsible long code block",
    "body": [
      "::code-collapse{name=\"${1:Full example}\"}",
      "```${2:ts} [${3:path/to/file.ts}]${4:}",
      "${5:// code}",
      "```",
      "::",
      "$0",
    ],
  },
  "Named code block": {
    "scope": "markdown,mdx",
    "prefix": ["mdcode", "codefile"],
    "description": "Code fence with filename and optional highlights",
    "body": ["```${1:ts} [${2:path/to/file.ts}]${3:}", "${4:// code}", "```", "$0"],
  },
  "MDC video player": {
    "scope": "markdown,mdx",
    "prefix": ["mdcvideo", "videoplayer", "video-player"],
    "description": "Self-hosted / MP4 VideoPlayer component",
    "body": [
      "::video-player{src=\"${1:https://example.com/video.mp4}\" title=\"${2:Video title}\" caption=\"${3:Optional caption.}\"}",
      "::",
      "$0",
    ],
  },
  "MDC YouTube embed": {
    "scope": "markdown,mdx",
    "prefix": ["mdcyoutube", "youtube"],
    "description": "YouTube VideoEmbed (loads on click)",
    "body": [
      "::video-embed{provider=\"youtube\" id=\"${1:dQw4w9WgXcQ}\" title=\"${2:YouTube title}\" caption=\"${3:Optional caption.}\"}",
      "::",
      "$0",
    ],
  },
  "MDC Bilibili embed": {
    "scope": "markdown,mdx",
    "prefix": ["mdcbilibili", "bilibili"],
    "description": "Bilibili VideoEmbed (loads on click)",
    "body": [
      "::video-embed{provider=\"bilibili\" id=\"${1:BV1xxxxxx}\" title=\"${2:Bilibili title}\" caption=\"${3:Optional caption.}\"}",
      "::",
      "$0",
    ],
  },
  "MDC Vimeo embed": {
    "scope": "markdown,mdx",
    "prefix": ["mdcvimeo", "vimeo"],
    "description": "Vimeo VideoEmbed (loads on click)",
    "body": [
      "::video-embed{provider=\"vimeo\" id=\"${1:123456789}\" title=\"${2:Vimeo title}\" caption=\"${3:Optional caption.}\"}",
      "::",
      "$0",
    ],
  },
  "MDC generic video embed": {
    "scope": "markdown,mdx",
    "prefix": ["mdcvideoembed", "videoembed", "video-embed"],
    "description": "Generic iframe VideoEmbed",
    "body": [
      "::video-embed{provider=\"${1|youtube,vimeo,bilibili,iframe|}\" id=\"${2:id-or-bvid}\" title=\"${3:Title}\" caption=\"${4:Optional caption.}\"}",
      "::",
      "$0",
    ],
  },
  "Blog image": {
    "scope": "markdown,mdx",
    "prefix": ["blogimg", "mdimage"],
    "description": "Markdown image (Tag Image domains apply)",
    "body": ["![${1:Alt text}](${2:https://images.pexels.com/...})", "$0"],
  },
  "Blog section skeleton": {
    "scope": "markdown,mdx",
    "prefix": ["blogsection", "section"],
    "description": "H2 section with lead paragraph",
    "body": ["## ${1:Section title}", "", "${2:Lead paragraph.}", "", "$0"],
  },
}
